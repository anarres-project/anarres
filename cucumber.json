{
  "default": {
    "paths": ["features/**/*.feature"],
    "import": ["acceptance/support/**/*.ts", "acceptance/steps/**/*.ts"],
    "tags": "not @wip",
    "format": ["progress"]
  },
  "wip": {
    "paths": ["features/**/*.feature"],
    "import": ["acceptance/support/**/*.ts", "acceptance/steps/**/*.ts"],
    "tags": "@wip",
    "format": ["progress", "message:reports/wip.ndjson"]
  },
  "sandbox": {
    "import": ["acceptance/support/**/*.ts", "acceptance/steps/**/*.ts"],
    "tags": "not @wip and not @sandbox-wip and not @in-process-only",
    "format": ["progress"],
    "parallel": 4
  }
}
