{
  "name": "anarres",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:acceptance",
    "test:unit": "vitest run --coverage",
    "test:acceptance": "NODE_OPTIONS=\"--import tsx\" cucumber-js",
    "test:acceptance:sandbox": "ANARRES_DRIVER=sandbox NODE_OPTIONS=\"--import tsx\" cucumber-js -p sandbox",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test:wip": "tsx scripts/wip-judge.ts",
    "mutate": "stryker run",
    "bundle": "npm run bundle -w @anarres/divlab && npm run bundle -w @anarres/cli"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cucumber/cucumber": "13.3.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
